# Long cache for hashed Vite build assets (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images & icons
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000

# Video
/*.mp4
  Cache-Control: public, max-age=2592000

# Manifest & robots
/site.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/llms.txt
  Cache-Control: public, max-age=86400

# Sitemap (dynamic route) - short cache
/sitemap.xml
  Cache-Control: public, max-age=3600
